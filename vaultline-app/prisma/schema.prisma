// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tool {
  gitleaks
  semgrep
  trivy
  npm_audit
  pip_audit
  url_scan
}

enum Severity {
  critical
  high
  medium
  low
}

enum ScanStatus {
  queued
  cloning
  scanning
  reporting
  completed
  failed
}

model Repo {
  id         String   @id @default(cuid())
  name       String
  fullName   String   @unique
  private    Boolean
  language   String?
  lastScanId String?

  scans      Scan[]
}

model Scan {
  id            String     @id @default(cuid())
  repoId        String
  repo          Repo       @relation(fields: [repoId], references: [id])
  userId        String?
  user          User?      @relation(fields: [userId], references: [id])
  status        ScanStatus
  queuePosition Int?
  createdAt     DateTime   @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  findings      Finding[]
  saved         Boolean    @default(false)
}

model Finding {
  id           String   @id @default(cuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  tool         Tool
  severity     Severity
  title        String
  description  String
  filePath     String
  lineNumber   Int?
  commitHash   String?
  cveId        String?
  suggestedFix String?
  ignored      Boolean  @default(false)
  plainSummary String?
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  password String?
  createdAt DateTime @default(now())
  reviews   Review[]
  scans     Scan[]
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  rating    Int
  text      String
  createdAt DateTime @default(now())
}

